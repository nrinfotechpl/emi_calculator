<resources >
    <!-- Base application theme. -->
    <style name="Base.Theme.EMICalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>

        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@color/white</item>

        <item name="android:windowLightStatusBar">true</item>

        <item name="textInputStyle">@style/CustomTextInputLayout</item>




    </style>
    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <!-- Border color -->
        <item name="boxStrokeColor">@color/border</item>

        <!-- Hint color -->
        <item name="hintTextColor">@color/border</item>
        
        <item name="android:state_focused">true</item>


    </style>


    <style name="Theme.EMICalculator" parent="Base.Theme.EMICalculator"/>

</resources>